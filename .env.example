# ---------- Telegram ----------
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
# ID Telegram kamu (pisahkan dengan koma jika lebih dari satu). Wajib diisi.
TELEGRAM_ALLOWED_USER_IDS=123456789

# ---------- AI (Sumopod AI) ----------
# API key dari https://ai.sumopod.com
SUMOPOD_API_KEY=sk-REPLACE_WITH_SUMOPOD_API_KEY
AI_BASE_URL=https://ai.sumopod.com/v1
AI_MODEL=glm-5.3-flash
AI_TIMEOUT_SECONDS=20
# Model yang mendukung gambar (vision) untuk foto struk
AI_VISION_MODEL=glm-5v-turbo
AI_VISION_TIMEOUT_SECONDS=45

# ---------- Google Sheets ----------
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_SHEET_ID=REPLACE_WITH_SPREADSHEET_ID

# ---------- Aplikasi ----------
TIMEZONE=Asia/Jakarta
CURRENCY=IDR
DEFAULT_ACCOUNT=Cash
LOG_LEVEL=INFO

# ---------- Web dashboard ----------
# Password login. Generate dengan:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_PASSWORD=
WEB_SECRET_KEY=
WEB_HOST=0.0.0.0
WEB_PORT=8000
SECURE_COOKIES=false
